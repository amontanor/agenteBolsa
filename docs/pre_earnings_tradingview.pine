//@version=6
strategy(
     "Pre-earnings score aproximado",
     overlay=true,
     max_labels_count=500,
     process_orders_on_close=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10)

// ---------------------------------------------------------------------------
// Pre-earnings score aproximado para TradingView.
//
// Importante:
// - Pine no puede leer nuestro SQLite, FMP, yfinance ni el calendario futuro completo.
// - request.earnings() devuelve datos de earnings en la barra donde TradingView los publica.
// - Este script sirve para testear una version aproximada: tecnico + historico de reaccion.
// - Para evitar mezclar escalas historicas del modelo Python, aqui el score siempre es 0-12.
// - El backtest entra en la barra del earnings cuando el score supera el umbral y sale en
//   la apertura siguiente. En la practica, revisa manualmente si el evento fue AMC/BMO.
// ---------------------------------------------------------------------------

// Inputs
scoreThresholdPct = input.float(80.0, "Umbral % estimacion", minval=0, maxval=100, step=1)
tradeEnabled = input.bool(false, "Activar backtest de entradas")
showLabels = input.bool(true, "Mostrar etiquetas en earnings")
showTable = input.bool(true, "Mostrar panel")
historySize = input.int(8, "Earnings historicos para base rate", minval=1, maxval=20)
bigGapThreshold = input.float(5.0, "Gap grande positivo (%)", minval=0.0, step=0.5) / 100.0
downGapThreshold = input.float(-5.0, "Gap negativo relevante (%)", maxval=0.0, step=0.5) / 100.0

// Earnings data from TradingView.
epsActual = request.earnings(syminfo.tickerid, earnings.actual, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
epsEstimate = request.earnings(syminfo.tickerid, earnings.estimate, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)
isEarningsBar = not na(epsActual) or not na(epsEstimate)

// Technical block, max 8 points.
sma20 = ta.sma(close, 20)
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
return20 = close / close[20] - 1.0
spyClose = request.security("AMEX:SPY", timeframe.period, close)
spyReturn20 = spyClose / spyClose[20] - 1.0
relative20 = return20 - spyReturn20
volMean20 = ta.sma(volume, 20)
volStd20 = ta.stdev(volume, 20)
volZ20 = volStd20 > 0 ? (volume - volMean20) / volStd20 : na

technicalScore = 0.0
technicalScore += close > sma200 ? 2.0 : 0.0
technicalScore += sma20 > sma50 ? 2.0 : 0.0
technicalScore += return20 > 0 ? 1.0 : 0.0
technicalScore += relative20 > 0 ? 2.0 : 0.0
technicalScore += volZ20 > 0.5 ? 1.0 : 0.0

// Historical earnings reaction block, max 4 points.
var array<float> earningsReturns = array.new_float()

// On the bar after an earnings bar, store close-before-event -> next-open reaction.
if bar_index > 1 and isEarningsBar[1] and not na(open) and not na(close[1])
    realizedRet = open / close[1] - 1.0
    array.unshift(earningsReturns, realizedRet)
    if array.size(earningsReturns) > historySize
        array.pop(earningsReturns)

histCount = array.size(earningsReturns)
positiveCount = 0
bigGapCount = 0
downGapCount = 0
sumRet = 0.0

if histCount > 0
    for i = 0 to histCount - 1
        r = array.get(earningsReturns, i)
        positiveCount += r > 0 ? 1 : 0
        bigGapCount += r >= bigGapThreshold ? 1 : 0
        downGapCount += r <= downGapThreshold ? 1 : 0
        sumRet += r

positiveRate = histCount > 0 ? positiveCount / histCount : na
bigGapRate = histCount > 0 ? bigGapCount / histCount : na
downGapRate = histCount > 0 ? downGapCount / histCount : na
avgReaction = histCount > 0 ? sumRet / histCount : na

historyScore = 0.0
historyScore += histCount >= 4 and positiveRate >= 0.60 ? 2.0 : 0.0
historyScore += histCount >= 4 and avgReaction > 0 ? 1.0 : 0.0
historyScore += histCount >= 4 and bigGapRate >= 0.25 ? 1.0 : 0.0
historyPenalty = histCount >= 4 and downGapRate >= 0.40 ? 1.0 : 0.0

score = math.max(0.0, technicalScore + historyScore - historyPenalty)
maxScore = 12.0
scorePct = score / maxScore

hypothesis = scorePct >= 0.80 ? "subida_probable" : scorePct >= 0.50 ? "neutral_alcista" : "sin_ventaja_clara"
scoreColor = scorePct >= 0.80 ? color.new(color.green, 0) : color.new(color.red, 0)

// Approximate strategy: enter on earnings bar close, exit next bar open.
longSignal = tradeEnabled and isEarningsBar and scorePct >= scoreThresholdPct / 100.0
if longSignal
    strategy.entry("PreE", strategy.long, comment="pre-earnings")

if strategy.position_size > 0 and strategy.opentrades > 0 and bar_index > strategy.opentrades.entry_bar_index(0)
    strategy.close("PreE", comment="next-open/proxy")

// Visuals.
plot(scorePct * 100.0, "Pre-earnings %", color=scoreColor, linewidth=2, display=display.pane)
hline(scoreThresholdPct, "Umbral", color=color.new(color.gray, 40), linestyle=hline.style_dashed)

plotshape(isEarningsBar, title="Earnings", style=shape.circle, location=location.abovebar, color=scoreColor, size=size.tiny, text="E")

if showLabels and isEarningsBar
    label.new(
         bar_index,
         high,
         "Earnings\n" + hypothesis + "\n" + str.tostring(scorePct * 100.0, "#.0") + "%",
         style=label.style_label_down,
         textcolor=color.white,
         color=scoreColor)

// Panel.
var table panel = table.new(position.top_right, 2, 9, border_width=1)
if showTable and barstate.islast
    table.cell(panel, 0, 0, "Pre-earnings", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(panel, 1, 0, syminfo.ticker, bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(panel, 0, 1, "Hipotesis")
    table.cell(panel, 1, 1, hypothesis, text_color=scoreColor)
    table.cell(panel, 0, 2, "Score")
    table.cell(panel, 1, 2, str.tostring(score, "#") + "/" + str.tostring(maxScore, "#"))
    table.cell(panel, 0, 3, "% estimacion")
    table.cell(panel, 1, 3, str.tostring(scorePct * 100.0, "#.0") + "%", text_color=scoreColor)
    table.cell(panel, 0, 4, "Tecnico")
    table.cell(panel, 1, 4, str.tostring(technicalScore, "#") + "/8")
    table.cell(panel, 0, 5, "Historial")
    table.cell(panel, 1, 5, str.tostring(historyScore - historyPenalty, "#") + "/4")
    table.cell(panel, 0, 6, "Hist +")
    table.cell(panel, 1, 6, na(positiveRate) ? "sin datos" : str.tostring(positiveRate * 100.0, "#.0") + "%")
    table.cell(panel, 0, 7, "Hist ret")
    table.cell(panel, 1, 7, na(avgReaction) ? "sin datos" : str.tostring(avgReaction * 100.0, "+#.00;-#.00") + "%")
    table.cell(panel, 0, 8, "Eventos hist.")
    table.cell(panel, 1, 8, str.tostring(histCount))
