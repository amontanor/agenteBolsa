# LLM
# Selector del primario general. Valores: opencode-go, opencode, mimo, custom.
# opencode-go usa OpenCode Go por defecto; configura OPENCODE_API_KEY.
LLM_MODEL_SELECTOR=opencode-go
OPENCODE_API_KEY=
OPENCODE_API_BASE=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=kimi-k2.6

# Perfil alternativo: MiMo por API.
# For MiMo Token Plan keys starting with tp-, use the regional Token Plan base URL.
# Europe: https://token-plan-ams.xiaomimimo.com/v1
# Singapore: https://token-plan-sgp.xiaomimimo.com/v1
# China: https://token-plan-cn.xiaomimimo.com/v1
# Pay-as-you-go sk- keys use https://api.xiaomimimo.com/v1.
MIMO_API_KEY=
MIMO_API_BASE=https://token-plan-ams.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Modo custom/legacy: solo se usa si LLM_MODEL_SELECTOR=custom.
OPENAI_API_KEY=
OPENAI_API_BASE=https://token-plan-ams.xiaomimimo.com/v1
OPENAI_MODEL_NAME=mimo-v2.5-pro
LLM_PRIMARY_PREFLIGHT_ENABLED=true
LLM_LOCAL_FALLBACK_ENABLED=true
LLM_LOCAL_FALLBACK_API_KEY=local-llama
LLM_LOCAL_FALLBACK_API_BASE=http://127.0.0.1:8080/v1
LLM_LOCAL_FALLBACK_MODEL=qwen3.6-27b
LLM_LOCAL_FALLBACK_PREFLIGHT_ENABLED=true
SECONDARY_REVIEW_LLM_ENABLED=false
SECONDARY_REVIEW_LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=120

# Router LLM por roles (T0.4). Vacio = cada rol usa la cadena por defecto.
# fast: sentimiento/resumenes (modelo local barato). decision: trade_decision.
# deep: programador/estrategas/retrospectivas (modelo potente; por defecto cae
# a IMPROVEMENT_LLM_* si no se define aqui).
LLM_ROLE_FAST_MODEL=
LLM_ROLE_FAST_BASE_URL=
LLM_ROLE_FAST_API_KEY=
LLM_ROLE_FAST_MAX_TOKENS=
LLM_ROLE_DECISION_MODEL=
LLM_ROLE_DECISION_BASE_URL=
LLM_ROLE_DECISION_API_KEY=
LLM_ROLE_DECISION_MAX_TOKENS=
LLM_ROLE_DEEP_MODEL=
LLM_ROLE_DEEP_BASE_URL=
LLM_ROLE_DEEP_API_KEY=
LLM_ROLE_DEEP_MAX_TOKENS=

CREWAI_PLANNING=false
CREW_AGENT_MAX_ITER=1
CREW_AGENT_MAX_EXECUTION_SECONDS=120
CREWAI_TRACING_ENABLED=false

# Mejora continua con LLM externo configurable
CONTINUOUS_IMPROVEMENT_ENABLED=true
IMPROVEMENT_LLM_ENABLED=false
IMPROVEMENT_LLM_PROVIDER=opencode-go
IMPROVEMENT_LLM_BASE_URL=https://opencode.ai/zen/go/v1
IMPROVEMENT_LLM_API_KEY=
IMPROVEMENT_LLM_MODEL=kimi-k2.6
IMPROVEMENT_LLM_ORCHESTRATOR_PROVIDER=opencode-go
IMPROVEMENT_LLM_ORCHESTRATOR_BASE_URL=https://opencode.ai/zen/go/v1
IMPROVEMENT_LLM_ORCHESTRATOR_API_KEY=
IMPROVEMENT_LLM_ORCHESTRATOR_MODEL=kimi-k2.6
IMPROVEMENT_LLM_TEMPERATURE=0.2
IMPROVEMENT_LLM_MAX_TOKENS=6000
IMPROVEMENT_LLM_TIMEOUT_SECONDS=120
IMPROVEMENT_LLM_RETRIES=2
IMPROVEMENT_LLM_LOCAL_FALLBACK_ENABLED=true
IMPROVEMENT_LLM_CONTEXT_TARGET_TOKENS=40000
IMPROVEMENT_LLM_CONTEXT_HARD_LIMIT_TOKENS=55000
IMPROVEMENT_LLM_LOCAL_CONTEXT_TARGET_TOKENS=30000
IMPROVEMENT_LLM_LOCAL_CONTEXT_HARD_LIMIT_TOKENS=50000
IMPROVEMENT_DRY_RUN=false
ALLOW_AUTO_APPLY_IMPROVEMENTS=true
REQUIRE_HUMAN_APPROVAL_FOR_CODE_CHANGES=false
REQUIRE_HUMAN_APPROVAL_FOR_HIGH_RISK=true
# Sandbox git real para cambios autonomos (T0.3). Cada cambio se valida en un
# worktree aislado con la suite completa antes de fusionarse a la rama de trabajo.
CI_SANDBOX_ENABLED=true
CI_SANDBOX_FULL_SUITE=true
CI_SANDBOX_VALIDATE_TIMEOUT_SECONDS=900
# Watchdog de cambios aplicados (T0.5): revierte solo un cambio cuyas metricas
# empeoran en las sesiones posteriores.
CHANGE_WATCHDOG_ENABLED=true
CHANGE_WATCHDOG_WINDOW_SESSIONS=5
CHANGE_WATCHDOG_MAX_IQ_DROP=10
CHANGE_WATCHDOG_MAX_HIT_RATE_DROP=0.15
CHANGE_WATCHDOG_MIN_TRADES=5
# Niveles de autonomia de codigo (T1.1). El nivel sube/baja solo segun historial.
CODE_AUTONOMY_LEVEL=1
AUTONOMY_PROMOTION_MIN_APPLIED=10
AUTONOMY_PROMOTION_CLEAN_SESSIONS=15
AUTONOMY_DEMOTE_ROLLBACKS=2
AUTONOMY_DEMOTE_SESSIONS=10
# Promocion champion/challenger de estrategias (T1.3).
PROMOTION_MIN_SESSIONS=10
PROMOTION_MIN_SIGNALS=20
PROMOTION_MAX_SESSIONS=25
PROMOTION_HIT_RATE_MARGIN=0.02
PROMOTION_MAX_DD_FACTOR=1.2
PROMOTION_HUMAN_VETO_HOURS=0
# ProgrammerAgent end-to-end: construccion autonoma de estrategias (T1.4).
CI_BUILD_STRATEGY_ENABLED=false
PROGRAMMER_MAX_REPAIR_ATTEMPTS=2
# Etapa 2: agentes que se mejoran a si mismos.
PROMPT_SELF_EDIT_ENABLED=false
MAX_DYNAMIC_AGENTS=8
NIGHTLY_RETROSPECTIVE_ENABLED=true
NIGHTLY_RETROSPECTIVE_MIN_EVIDENCE=3
LESSONS_INJECTION_ENABLED=true
MAX_ACTIVE_LESSONS=40
# Etapa 3: comprension del mercado.
MACRO_THESIS_ENABLED=true
RISK_OFF_BUY_FACTOR=0.5
RISK_OFF_CONFIDENCE_THRESHOLD=0.7
FACTORY_MAX_VARIANTS_PER_NIGHT=50
FACTORY_WORKERS=4
FACTORY_MAX_MINUTES=60
PATTERN_DYNAMIC_WEIGHTS_ENABLED=false
PATTERN_MIN_OCCURRENCES=30
# Etapa 4: gobierno por riesgo y camino a live.
RISK_BUDGET_ENABLED=false
RISK_BUDGET_DAILY_VAR_PCT=0.03
RISK_BUDGET_MAX_NEW_RISK_PER_DAY_PCT=0.015
RISK_BUDGET_MAX_CORRELATED_CLUSTER_PCT=0.012
LIVE_CAPITAL_FRACTION=0.10
# Etapa 5: robustez de trading (edge, estadistica y realismo).
# T5.1: freeze hasta validar edge base. T5.2: cordura estadistica. T5.5/6/7/9/10.
SYSTEM_FREEZE_MODE=false
PROMOTION_BINOMIAL_MAX_P=0.10
MAX_CONCURRENT_PROMOTIONS=2
MAX_PROMOTIONS_PER_WEEK=1
SURVIVORSHIP_HAIRCUT=0.25
CASH_FLOOR_RISK_OFF=0.60
CASH_FLOOR_NEUTRAL=0.25
FACTORY_REGIME_QUOTA=0.30
SHORTS_SHADOW_ENABLED=true
LESSON_REVALIDATION_WINDOW=10
LESSON_MIN_SUPPORTING=30
EARNINGS_HOLD_MAX_DAYS=2
EARNINGS_HOLD_POLICY=reduce
# T5.5 realismo de ejecucion (slippage/limit/costes).
PAPER_SYNTHETIC_SLIPPAGE_BPS=10
MAX_ENTRY_GAP_PCT=0.015
USE_LIMIT_ENTRIES=true
# T5.9 presupuesto economico del laboratorio. 0 = sin limite.
LLM_DAILY_BUDGET_USD=5.0
LLM_ROLE_DEEP_DAILY_BUDGET_USD=3.0
# T5.11 diversidad real del comite: usa >=2 proveedores entre decision y deep.
#   Ej: LLM_ROLE_DECISION_* -> Gemini ; LLM_ROLE_DEEP_* -> MiMo/otro.
CONTINUOUS_IMPROVEMENT_SCHEDULE_ENABLED=true
CONTINUOUS_IMPROVEMENT_TIME_LOCAL=23:30
CONTINUOUS_IMPROVEMENT_RUNTIME_INTERVAL_SECONDS=60
CONTINUOUS_IMPROVEMENT_GROUP_COOLDOWN_SECONDS=300
CONTINUOUS_IMPROVEMENT_EVENT_COOLDOWN_SECONDS=1800
CONTINUOUS_IMPROVEMENT_RUNTIME_LOOP_SLEEP_SECONDS=15
CONTINUOUS_IMPROVEMENT_RETRY_BASE_SECONDS=180
CONTINUOUS_IMPROVEMENT_RETRY_MAX_SECONDS=900
CONTINUOUS_IMPROVEMENT_MAX_PROPOSALS_PER_CYCLE=5
# Optional. Defaults to the repository root inferred from DATA_DIR.
CONTINUOUS_IMPROVEMENT_WORKSPACE_DIR=

# --- Ciclo de vida del laboratorio (Etapa 7): el lab debe TERMINAR trabajo ---
# Tarea no terminal mas vieja que esto -> CANCELLED (y sus dependientes).
CI_TASK_TTL_HOURS=48
# Iniciativa abierta mas de TTL dias y sin avance en STALL dias -> expirada.
CI_INITIATIVE_TTL_DAYS=5
CI_INITIATIVE_STALL_DAYS=3
# Iniciativa en MONITORING sin movimiento estos dias -> CLOSED con outcome.
CI_MONITORING_CLOSE_DAYS=5
# Maximo de iniciativas activas a la vez (WIP) y cooldown anti-duplicados.
CI_MAX_OPEN_INITIATIVES=6
CI_RECURRING_COOLDOWN_HOURS=24

# Trading
TRADING_MODE=paper
TRADE_AGGRESSIVENESS_PROFILE=opportunistic
ALLOW_LIVE_TRADING=false
BROKER=alpaca
# Tambien se acepta ALPACA_KEY como alias de ALPACA_API_KEY.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# Universe
DEFAULT_UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
BENCHMARK_SYMBOL=SPY
MARKET_DATA_PROVIDER=auto
LIVE_REQUIRES_FORMAL_MARKET_DATA=true
MARKET_REGIME_POLICY_ENABLED=true

# Risk limits
MAX_PORTFOLIO_EXPOSURE=0.50
MAX_POSITION_EXPOSURE=0.05
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MIN_BACKTEST_TRADES=50
MIN_OUT_OF_SAMPLE_SHARPE=0.80
MAX_STRATEGY_DRAWDOWN=0.15
AUTO_PAPER_TRADING=false
REQUIRE_HUMAN_APPROVAL=true
DETERMINISTIC_TRADE_FALLBACK_ENABLED=true
MAX_RISK_PER_TRADE=0.01
MAX_ORDERS_PER_CYCLE=4
MAX_DAILY_BUY_ORDERS=4
MICRO_EXPERIMENT_SIZE_MULTIPLIER=0.50
BACKTEST_GATE_PAPER_SOFT_OVERRIDE_ENABLED=true
MIN_LLM_CONFIDENCE_TO_TRADE=0.65
ALLOW_SHORT_SELLING=false
USE_BRACKET_ORDERS=true

# Runtime
RUN_INTERVAL_SECONDS=900
PORTFOLIO_WATCH_INTERVAL_SECONDS=60
MARKET_CYCLE_INTERVAL_MINUTES=15
CLOSED_MARKET_STUDY_INTERVAL_MINUTES=15
CLOSED_MARKET_STUDY_UNIVERSE=sp500
CLOSED_MARKET_STUDY_MAX_SYMBOLS=500
INTRADAY_TECHNICAL_SCAN_ENABLED=true
INTRADAY_TECHNICAL_SCAN_UNIVERSE=
INTRADAY_TECHNICAL_SCAN_MAX_SYMBOLS=0
INTRADAY_NEWS_SENTIMENT_ENABLED=false
NEWS_SENTIMENT_ENABLED=true
NEWS_SENTIMENT_TOP_N=10
TRADE_SELECTION_TOP_N=24
NEWS_ITEMS_PER_SYMBOL=5
NEWS_SENTIMENT_FAIL_CLOSED_FOR_BUYS=false
ENTRY_SCORE_V2_ENABLED=true
ENTRY_SCORE_V2_MIN=0.52
ENTRY_SCORE_V2_MICRO_MIN=0.46
ENTRY_SCORE_V2_MIN_REWARD_RISK=1.5
EXIT_POLICY_V2_ENABLED=true
EXIT_POLICY_V2_PARTIAL_R=1.0
EXIT_POLICY_V2_TRAILING_R=2.0
EXIT_POLICY_V2_TRAILING_GIVEBACK_R=1.0
EXIT_POLICY_V2_TIME_STOP_DAYS=5
EXIT_POLICY_V2_TIME_STOP_MIN_RETURN=0.0
OPEN_POSITION_NEWS_GUARD_ENABLED=true
OPEN_POSITION_NEWS_GUARD_INTERVAL_MINUTES=30
PRE_EARNINGS_ENABLED=true
PRE_EARNINGS_DAYS=5
PRE_EARNINGS_BEFORE_CLOSE_MINUTES=60
PRE_EARNINGS_TIME_MARKET=15:00
PRE_EARNINGS_UNIVERSE=
PRE_EARNINGS_MAX_SYMBOLS=0
PRE_EARNINGS_TRADE_ENABLED=false
PRE_EARNINGS_TRADE_MIN_SCORE_V2=70
PRE_EARNINGS_TRADE_TARGET_EXPOSURE_PCT=0.025
FMP_API_KEY=
DAILY_STUDY_TIME_LOCAL=23:00
LOCAL_TIMEZONE=Europe/Madrid
MARKET_CALENDAR=XNYS
DATA_DIR=data
RETENTION_ENABLED=true
REPORT_RETENTION_DAYS=30
LOG_RETENTION_DAYS=30
CACHE_RETENTION_DAYS=7
DISABLED_REPORT_PREFIXES=postmortem_signals,missed_opportunities,decision_compare,walk_forward_validation,session_retrospective
LOG_LEVEL=INFO
