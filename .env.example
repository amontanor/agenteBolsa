# LLM
OPENAI_API_KEY=local-llama
OPENAI_API_BASE=http://127.0.0.1:8080/v1
OPENAI_MODEL_NAME=qwen3.6-27b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=120
CREWAI_PLANNING=false
CREW_AGENT_MAX_ITER=1
CREW_AGENT_MAX_EXECUTION_SECONDS=120
CREWAI_TRACING_ENABLED=false

# Trading
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
BROKER=alpaca
# Tambien se acepta ALPACA_KEY como alias de ALPACA_API_KEY.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# Universe
DEFAULT_UNIVERSE=SPY,QQQ,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA
BENCHMARK_SYMBOL=SPY

# Risk limits
MAX_PORTFOLIO_EXPOSURE=0.50
MAX_POSITION_EXPOSURE=0.05
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MIN_BACKTEST_TRADES=50
MIN_OUT_OF_SAMPLE_SHARPE=0.80
MAX_STRATEGY_DRAWDOWN=0.15
AUTO_PAPER_TRADING=false
REQUIRE_HUMAN_APPROVAL=true
MAX_RISK_PER_TRADE=0.01
MAX_ORDERS_PER_CYCLE=3
MAX_DAILY_BUY_ORDERS=3
MIN_LLM_CONFIDENCE_TO_TRADE=0.65
ALLOW_SHORT_SELLING=false
USE_BRACKET_ORDERS=true

# Runtime
RUN_INTERVAL_SECONDS=900
PORTFOLIO_WATCH_INTERVAL_SECONDS=60
MARKET_CYCLE_INTERVAL_MINUTES=15
CLOSED_MARKET_STUDY_INTERVAL_MINUTES=15
CLOSED_MARKET_STUDY_UNIVERSE=sp500
CLOSED_MARKET_STUDY_MAX_SYMBOLS=500
INTRADAY_TECHNICAL_SCAN_ENABLED=true
INTRADAY_TECHNICAL_SCAN_UNIVERSE=
INTRADAY_TECHNICAL_SCAN_MAX_SYMBOLS=0
INTRADAY_NEWS_SENTIMENT_ENABLED=false
NEWS_SENTIMENT_ENABLED=true
NEWS_SENTIMENT_TOP_N=10
NEWS_ITEMS_PER_SYMBOL=5
NEWS_SENTIMENT_FAIL_CLOSED_FOR_BUYS=true
OPEN_POSITION_NEWS_GUARD_ENABLED=true
OPEN_POSITION_NEWS_GUARD_INTERVAL_MINUTES=30
PRE_EARNINGS_ENABLED=true
PRE_EARNINGS_DAYS=5
PRE_EARNINGS_BEFORE_CLOSE_MINUTES=60
PRE_EARNINGS_TIME_MARKET=15:00
PRE_EARNINGS_UNIVERSE=
PRE_EARNINGS_MAX_SYMBOLS=0
FMP_API_KEY=
DAILY_STUDY_TIME_LOCAL=23:00
LOCAL_TIMEZONE=Europe/Madrid
MARKET_CALENDAR=XNYS
DATA_DIR=data
RETENTION_ENABLED=true
REPORT_RETENTION_DAYS=30
LOG_RETENTION_DAYS=30
CACHE_RETENTION_DAYS=7
DISABLED_REPORT_PREFIXES=postmortem_signals,missed_opportunities,decision_compare,walk_forward_validation,session_retrospective
LOG_LEVEL=INFO
